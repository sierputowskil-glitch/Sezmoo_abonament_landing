{
  "name": "sezmoo-abonament",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SEZMOO abonament landing — Astro (static) + Cloudflare Pages Function for contact",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync:assets": "node scripts/sync-public-assets.mjs",
    "predev": "npm run sync:assets",
    "dev": "astro dev",
    "prebuild": "npm run sync:assets",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:functions": "wrangler pages dev ./dist --compatibility-date=2026-10-15 --compatibility-flags=nodejs_compat",
    "postinstall": "node scripts/patch-cloudflare-smtp.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "astro": "^5.14.0",
    "cloudflare-smtp": "^0.1.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^9.37.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "wrangler": "^4.42.0"
  }
}
