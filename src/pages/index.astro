---
import CampaignLayout from '../layouts/CampaignLayout.astro';
import FloatingSocials from '../components/FloatingSocials.astro';
import IconSprite from '../components/IconSprite.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Jobs from '../components/Jobs.astro';
import Process from '../components/Process.astro';
import Packages from '../components/Packages.astro';
import Works from '../components/Works.astro';
import Why from '../components/Why.astro';
import Scope from '../components/Scope.astro';
import ForWhom from '../components/ForWhom.astro';
import Logos from '../components/Logos.astro';
import Quotes from '../components/Quotes.astro';
import Team from '../components/Team.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { buildJsonLd } from '../lib/jsonLd';

const title = 'Abonament na wideo, foto i grafikę – wsparcie marketingu | SEZMOO';
const description =
  'Elastyczny abonament produkcyjny dla działów marketingu. Wideo, fotografia, grafika i content w jednej puli godzin, z dedykowanym zespołem SEZMOO.';
const ogTitle = 'Kompleksowe wsparcie dla marketingu – abonament SEZMOO';
const ogDescription =
  'Wideo, fotografia, grafika i content w jednej miesięcznej puli godzin. Pakiety 30h, 60h, 120h i Custom. Stały zespół SEZMOO.';
const jsonLd = await buildJsonLd();
---

<CampaignLayout
  title={title}
  description={description}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  jsonLd={jsonLd}
>
  <FloatingSocials />
  <a class="skip" href="#main">Przejdź do treści</a>
  <IconSprite />
  <Header />
  <main id="main">
    <Hero />
    <Jobs />
    <Process />
    <Packages />
    <Works />
    <Why />
    <Scope />
    <ForWhom />
    <Logos />
    <Quotes />
    <Team />
    <Faq />
    <Contact />
  </main>
  <Footer />
  <MobileBar />
</CampaignLayout>
