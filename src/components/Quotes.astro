---
import { getCollection } from 'astro:content';

const quotes = (await getCollection('quotes')).sort((a, b) => a.data.order - b.data.order);
---

<section class="sec" aria-labelledby="quotes-h" style="padding-top:0">
  <div class="shell">
    <h2 class="h2" id="quotes-h" style="margin-bottom:clamp(32px,4vw,48px)"
      >Co mówią <span class="em">nasi klienci.</span></h2
    >
    <ul class="quotes">
      {
        quotes.map((q) => (
          <li class="quote">
            <blockquote>{q.data.quote}</blockquote>
            <cite>{q.data.cite}</cite>
          </li>
        ))
      }
    </ul>
  </div>
</section>
