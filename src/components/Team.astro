---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const members = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
---

<section class="sec dark team-sec" aria-labelledby="team-h" style="padding-top:clamp(110px,11vw,150px)">
  <svg class="tear" fill="#F5F3EF" aria-hidden="true"><use href="#tear"></use></svg>
  <div class="shell">
    <div class="sec__head">
      <h2 class="h2" id="team-h">Poznaj zespół, który <span class="em">będzie wspierać Twój marketing.</span></h2>
      <p class="mono">Stały zespół · Gdańsk / Polska</p>
    </div>
    <ul class="team">
      {
        members.map((m) => (
          <li class="tm">
            <div class="tm__ph">
              <Image
                src={m.data.image}
                alt={m.data.alt}
                widths={[300, 600]}
                sizes="(min-width: 900px) 22vw, 45vw"
                format="webp"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="tm__b">
              <span class="tm__no">{m.data.no}</span>
              <h3>{m.data.name}</h3>
              <p class="tm__r">{m.data.role}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
