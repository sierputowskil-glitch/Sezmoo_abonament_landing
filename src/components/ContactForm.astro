---
/**
 * Abonament contact form markup + bundled client (Turnstile / API / dataLayer).
 */
import { NEED_OPTIONS, PACKAGE_OPTIONS } from '../lib/site';
import { publicUrl } from '../lib/publicUrl';

interface Props {
  formId?: string;
}

const { formId = 'abonament-form' } = Astro.props;
---

<form
  class="cform"
  id={formId}
  name="abonament"
  method="POST"
  action={publicUrl('api/contact')}
  novalidate
>
  <input type="hidden" name="form-name" value="abonament" />
  <input type="hidden" name="lang" value="pl" />
  <p hidden aria-hidden="true">
    <label>Nie wypełniaj: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>
  <div class="cform__row">
    <div class="cfield">
      <label for="ab-name">Imię i nazwisko</label><input
        id="ab-name"
        name="name"
        type="text"
        autocomplete="name"
        placeholder="Jan Kowalski"
        required
      />
    </div>
    <div class="cfield">
      <label for="ab-company">Firma</label><input
        id="ab-company"
        name="company"
        type="text"
        autocomplete="organization"
        placeholder="Nazwa firmy"
      />
    </div>
  </div>
  <div class="cform__row">
    <div class="cfield">
      <label for="ab-email">E-mail</label><input
        id="ab-email"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        placeholder="ty@firma.pl"
        required
      />
    </div>
    <div class="cfield">
      <label for="ab-phone">Telefon</label><input
        id="ab-phone"
        name="phone"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        placeholder="+48 ..."
      />
    </div>
  </div>
  <div class="cform__row">
    <div class="cfield">
      <label for="ab-need">Obszar</label>
      <select id="ab-need" name="need" required>
        {
          NEED_OPTIONS.map((opt) =>
            opt.value === '' ? (
              <option value="">{opt.label}</option>
            ) : (
              <option value={opt.value}>{opt.label}</option>
            ),
          )
        }
      </select>
    </div>
    <div class="cfield">
      <label for="ab-package">Pakiet</label>
      <select id="ab-package" name="package">
        {
          PACKAGE_OPTIONS.map((opt) => (
            <option value={opt.value} selected={'selected' in opt && opt.selected}>
              {opt.label}
            </option>
          ))
        }
      </select>
    </div>
  </div>
  <div class="cfield">
    <label for="ab-msg">Wiadomość</label><textarea
      id="ab-msg"
      name="message"
      placeholder="Ile materiałów miesięcznie, jakie kanały..."
      minlength="10"
      required></textarea>
  </div>
  <label class="cconsent"
    ><input type="checkbox" name="consent" value="1" required />
    <span
      >Wyrażam zgodę na&nbsp;przetwarzanie moich danych w&nbsp;celu kontaktu, zgodnie z&nbsp;<a
        href="https://sezmoo.com/polityka-prywatnosci/"
        target="_blank"
        rel="noopener">polityką prywatności</a
      > SEZMOO.</span
    ></label
  >
  <button class="btn btn--y" type="submit"
    ><span class="ico"></span><span class="lbl">Wyślij zapytanie o&nbsp;abonament</span></button
  >
  <p class="cform__note" role="status" aria-live="polite">● REC · Odpowiadamy w ciągu 24h</p>
</form>

<script>
  import { initContactForm } from '../scripts/form';
  // Keep in sync with default Props.formId (define:vars breaks ESM bundling).
  initContactForm('abonament-form');
</script>
