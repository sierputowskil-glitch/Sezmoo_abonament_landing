---
import { Image } from 'astro:assets';
import { publicUrl } from '../lib/publicUrl';
import ytAudi from '../assets/abonament/yt-audi-rs3.webp';
import ytJaecoo from '../assets/abonament/yt-jaecoo.webp';
import zakresFoto from '../assets/abonament/zakres-foto.webp';
import sohoForm from '../assets/abonament/realizacja-soho-form.webp';
---

<section class="sec" aria-labelledby="scope-h" style="padding-top:0">
  <div class="shell">
    <div class="sec__head">
      <h2 class="h2" id="scope-h">
        Wideo, foto, grafika i&nbsp;content – <span class="em">w&nbsp;jednym zespole.</span>
      </h2>
      <p class="lead">
        Łączysz kompetencje w&nbsp;ramach ustalonej puli godzin i&nbsp;dopasowujesz je do&nbsp;planu
        komunikacji swojej marki.
      </p>
    </div>
    <ul class="scope">
      <li>
        <div class="scope__img scope__img--vid" data-bg-video>
          <Image
            src={ytAudi}
            alt="Audi RS3 – film promocyjny samochodu, realizacja wideo SEZMOO"
            widths={[360, 720]}
            sizes="(min-width: 900px) 22vw, 70vw"
            format="webp"
            loading="lazy"
          />
          <video
            muted
            loop
            playsinline
            webkit-playsinline
            preload="metadata"
            width="720"
            height="900"
            aria-hidden="true"
            src={publicUrl('assets/abonament/video/audi-rs3.mp4')}
          ></video>
        </div>
        <h3>Wideo</h3>
        <p>Filmy promocyjne, rolki, relacje, ujęcia z&nbsp;drona i&nbsp;montaż.</p>
      </li>
      <li>
        <div class="scope__img">
          <Image
            src={zakresFoto}
            alt="Reflektor LED Audi RS5 w czerwonym świetle – studyjna sesja zdjęciowa samochodu SEZMOO"
            widths={[360, 720]}
            sizes="(min-width: 900px) 22vw, 70vw"
            format="webp"
            loading="lazy"
          />
        </div>
        <h3>Fotografia</h3>
        <p>Sesje produktowe, wizerunkowe, firmowe i&nbsp;eventowe.</p>
      </li>
      <li>
        <div class="scope__img" style="background:#ffd200">
          <Image
            style="object-fit:contain"
            src={sohoForm}
            alt="Strona internetowa Soho Form na laptopie i telefonie – projekt WWW SEZMOO"
            widths={[450, 900]}
            sizes="(min-width: 900px) 22vw, 70vw"
            format="webp"
            loading="lazy"
          />
        </div>
        <h3>Grafika i&nbsp;WWW</h3>
        <p>
          Grafiki do&nbsp;social mediów, materiały sprzedażowe, projekty do&nbsp;druku, aktualizacje
          stron i&nbsp;landing page.
        </p>
      </li>
      <li>
        <div class="scope__img scope__img--vid" data-bg-video>
          <Image
            src={ytJaecoo}
            alt="JAECOO Mundial – animacja do social media, realizacja SEZMOO"
            widths={[360, 720]}
            sizes="(min-width: 900px) 22vw, 70vw"
            format="webp"
            loading="lazy"
          />
          <video
            muted
            loop
            playsinline
            webkit-playsinline
            preload="metadata"
            width="720"
            height="900"
            aria-hidden="true"
            src={publicUrl('assets/abonament/video/jaecoo-mundial.mp4')}
          ></video>
        </div>
        <h3>Content i&nbsp;social media</h3>
        <p>
          Materiały do&nbsp;publikacji, posty, stories i&nbsp;wsparcie w&nbsp;planowaniu
          komunikacji.
        </p>
      </li>
    </ul>
    <p class="mono swipe" aria-hidden="true">Przesuń →</p>
  </div>
</section>
