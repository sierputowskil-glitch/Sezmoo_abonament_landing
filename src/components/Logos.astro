---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const logos = (await getCollection('clients')).sort((a, b) => a.data.order - b.data.order);
---

<section class="logos" aria-labelledby="logos-h">
  <div class="shell">
    <div class="logos__top">
      <h2 class="mono" id="logos-h">Zaufali nam</h2>
      <p class="mono">Wideo / foto / grafika</p>
    </div>
    <div class="logo-marquee" aria-label="Marki, z którymi pracujemy">
      <div class="logo-track">
        {
          logos.map((logo) => (
            <div class="logo-cellc">
              <Image
                class="logo-mark"
                style={`--k:${logo.data.scale}`}
                src={logo.data.image}
                alt={logo.data.alt}
                width={logo.data.width}
                height={logo.data.height}
                loading="lazy"
                decoding="async"
              />
            </div>
          ))
        }
        {
          logos.map((logo) => (
            <div class="logo-cellc" aria-hidden="true">
              <Image
                class="logo-mark"
                style={`--k:${logo.data.scale}`}
                src={logo.data.image}
                alt=""
                width={logo.data.width}
                height={logo.data.height}
                loading="lazy"
                decoding="async"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
