---
const logos = [
  { src: '/assets/clients/audi-grupa-plichta.png', alt: 'Audi Grupa Plichta', k: '0.85' },
  { src: '/assets/clients/byd-plichta.png', alt: 'BYD Plichta', k: '0.62' },
  { src: '/assets/clients/netto.svg', alt: 'Netto', k: '1.05' },
  { src: '/assets/clients/omoda-jaecoo.svg', alt: 'Omoda & Jaecoo', k: '1.20' },
  { src: '/assets/clients/cherry.svg', alt: 'Chery', k: '0.50' },
  { src: '/assets/clients/vls.svg', alt: 'VLS', k: '1.27' },
  { src: '/assets/clients/doraco.svg', alt: 'Doraco', k: '0.71' },
  { src: '/assets/clients/k2.svg', alt: 'K2', k: '1.70' },
  { src: '/assets/clients/baltic-towers.svg', alt: 'Baltic Towers', k: '1.70' },
  { src: '/assets/clients/q4rail.svg', alt: 'Q4rail', k: '0.92' },
  { src: '/assets/clients/crt.svg', alt: 'CRT', k: '1.25' },
  { src: '/assets/clients/2track.svg', alt: '2track', k: '1.50' },
  { src: '/assets/clients/life-dom-seniora.svg', alt: 'Life Dom Seniora', k: '1.21' },
];
---

<section class="logos" aria-labelledby="logos-h">
  <div class="shell">
    <div class="logos__top">
      <h2 class="mono" id="logos-h">Zaufali nam</h2>
      <p class="mono">Wideo / foto / grafika</p>
    </div>
    <div class="logo-marquee" aria-label="Marki, z którymi pracujemy">
      <div class="logo-track">
        {
          logos.map((logo) => (
            <div class="logo-cellc">
              <img
                class="logo-mark"
                style={`--k:${logo.k}`}
                src={logo.src}
                alt={logo.alt}
                loading="lazy"
              />
            </div>
          ))
        }
        {
          logos.map((logo) => (
            <div class="logo-cellc" aria-hidden="true">
              <img
                class="logo-mark"
                style={`--k:${logo.k}`}
                src={logo.src}
                alt=""
                loading="lazy"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
