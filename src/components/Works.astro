---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
---

<section class="sec dark" aria-labelledby="works-h" style="padding-top:clamp(110px,11vw,150px)">
  <svg class="tear" fill="#F5F3EF" aria-hidden="true"><use href="#tear"></use></svg>
  <div class="shell">
    <div class="sec__head">
      <h2 class="h2" id="works-h">Zobacz, co tworzymy <span class="em y">dla&nbsp;marek.</span></h2>
      <p class="lead">Wideo, fotografia, grafika i&nbsp;kampanie – efekty pracy naszego zespołu.</p>
    </div>
    <ul class="works">
      {
        works.map((w) => {
          const d = w.data;
          return (
            <li>
              <a class="work" href={d.href} data-cta={d.ctaId}>
                <div class="work__img" style={d.bg ? `background:${d.bg}` : undefined}>
                  <Image
                    src={d.image}
                    alt={d.alt}
                    widths={[480, 720, 960]}
                    sizes="(min-width: 900px) 30vw, 80vw"
                    format="webp"
                    loading="lazy"
                    decoding="async"
                    style={d.contain ? 'object-fit:contain' : undefined}
                  />
                  <span class="work__tag">{d.tag}</span>
                </div>
                <div class="work__meta">
                  <h3>{d.title}</h3>
                  <p>{d.subtitle}</p>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
    <p class="mono swipe" aria-hidden="true">Przesuń →</p>
    <div class="works__more"
      ><a class="btn btn--ghost-y btn--xl" href="https://sezmoo.com/portfolio/" data-cta="portfolio"
        >Zobacz portfolio <svg aria-hidden="true"><use href="#i-arrow"></use></svg></a
      ></div
    >
  </div>
</section>
