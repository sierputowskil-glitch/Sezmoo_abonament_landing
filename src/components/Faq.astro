---
import { getCollection } from 'astro:content';

const items = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
---

<section class="sec" aria-labelledby="faq-h" style="padding-top:clamp(110px,11vw,150px)">
  <svg class="tear" fill="#0A0806" aria-hidden="true"><use href="#tear"></use></svg>
  <div class="shell faq">
    <h2 class="h2" id="faq-h">Najczęściej <span class="em">zadawane pytania.</span></h2>
    <div class="faq__list">
      {
        items.map((item) => (
          <details open={item.data.open || undefined}>
            <summary>
              {item.data.question}
              <svg aria-hidden="true">
                <use href="#i-plus" />
              </svg>
            </summary>
            <p>{item.data.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
