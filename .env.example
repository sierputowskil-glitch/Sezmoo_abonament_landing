# Public client env (astro:env schema in astro.config.mjs). Copy to .env (gitignored).
PUBLIC_SITE_URL=https://abonament.sezmoo.com
PUBLIC_BASE_PATH=/
# Local `astro dev` ignores this and forces invisible dummy `1x00000000000000000000BB`.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB
# Staging/preview CI must NOT use the dummy site key. Dummy secrets are rejected
# on Pages unless ALLOW_TURNSTILE_TEST=1 (local wrangler only).
# Same-origin on CF Pages / wrangler pages dev.
PUBLIC_CONTACT_API_URL=/api/contact
# GTM: boolean — only set true in production CI. Omit locally / staging (default false).
# PUBLIC_ENABLE_GTM=true
# Force noindex (also auto when PUBLIC_SITE_URL contains pages.dev):
# PUBLIC_ROBOTS=noindex

# Server secrets live in .dev.vars (Wrangler) / CF dashboard — not in .env:
# TURNSTILE_SECRET_KEY, SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS,
# SMTP_FROM, SMTP_FROM_NAME, MAIL_TO

# Deploy (prod + Pages preview staging) — sezmoo.com Cloudflare account:
# PROD_CLOUDFLARE_ACCOUNT_ID=
# PROD_CLOUDFLARE_API_TOKEN=
